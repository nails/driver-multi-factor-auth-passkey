{
    "name": "nails/driver-multi-factor-auth-passkey",
    "description": "Passkey (WebAuthn) MFA Driver for Nails",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nails/module-multi-factor-auth": "dev-develop",
        "nails/module-auth": "dev-develop"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload": {
        "psr-4": {
            "Nails\\MFA\\Driver\\Authentication\\": "src/",
            "Nails\\MFA\\Driver\\Authentication\\Passkey\\": "src/Passkey/"
        }
    },
    "extra": {
        "nails": {
            "type": "driver",
            "subType": "authentication",
            "forModule": "nails/module-multi-factor-auth",
            "namespace": "Nails\\MFA\\Driver\\Authentication\\Passkey\\",
            "data": {
                "namespace": "Nails\\MFA\\Driver\\Authentication\\",
                "class": "Passkey"
            }
        }
    }
}
